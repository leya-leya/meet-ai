{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autodev review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "issues"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FIX", "BLOCKED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "problem", "recommendation"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
